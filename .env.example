# Variables de Entorno - Banbajío

# Puerto del servidor
PORT=5000

# Base de datos MongoDB
# Para Railway, usa la URI que proporciona MongoDB Atlas
# Ejemplo: mongodb+srv://usuario:contraseña@cluster.mongodb.net/banbajio
MONGODB_URI=mongodb://localhost:27017/banbajio

# Secreto para JWT (cámbialo por algo más seguro)
JWT_SECRET=secreto_banbajio_super_seguro_2024

# CORS - URL del frontend (para Railway)
FRONTEND_URL=http://localhost:3000